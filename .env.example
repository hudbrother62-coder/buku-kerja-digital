# Supabase browser settings
VITE_SUPABASE_URL=https://YOUR_BKD_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_BKD_KEY

# Vercel server-side settings: Gemini keys are no longer used
SUPABASE_URL=https://YOUR_BKD_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_BKD_KEY
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# GROQ_API_KEY is an alias for slot 1
# Groq models are detected automatically through the /models endpoint.
