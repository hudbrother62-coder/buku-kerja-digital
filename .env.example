# Client-side Supabase values are safe to expose in the browser, but must belong
# only to the dedicated Buku Kerja Digital Supabase project.
VITE_SUPABASE_URL=https://YOUR_BKD_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_BKD_KEY

# Vercel server environment variables for /api/ai.
SUPABASE_URL=https://YOUR_BKD_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_BKD_KEY
# Groq models are automatically selected from /models per API key
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# Personal Groq keys are currently stored in browser localStorage; migrate to encrypted server storage before handling sensitive deployments.
